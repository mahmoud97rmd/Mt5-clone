# --- Flutter / Dart ---
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# --- Android ---
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
android/local.properties
android/key.properties
android/keystore.properties
android/*.jks
android/*.keystore

# --- iOS ---
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.flx
ios/Flutter/engine/
ios/Runner/GeneratedPluginRegistrant.*

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Generated code (regenerate with build_runner) ---
# Uncomment if you want to track generated files:
# *.g.dart
# *.freezed.dart

# --- Chaquopy ---
android/app/src/main/python/__pycache__/
*.pyc

# --- Secrets ---
.env
.env.*
*.env
google-services.json
GoogleService-Info.plist

# --- Logs ---
*.log
logs/
